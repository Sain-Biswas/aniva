{
	"$schema": "node_modules/turbo/schema.json",

	"ui": "tui",

	"tasks": {
		/* development */
		"dev": {
			"cache": false,
			"persistent": true
		},

		/* build */
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},

		/* linting */
		"lint": {
			"dependsOn": ["^lint"]
		},
		"lint:fix": {
			"dependsOn": ["^lint:fix"]
		},

		/* check types */
		"check-types": {
			"dependsOn": ["^check-types"]
		}
	}
}
